{
  "name": "sismant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --include .env server/index.ts",
    "start:server": "tsx server/index.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "db:migrate": "tsx server/migrate-cli.ts",
    "db:migrate-maintenance": "tsx server/migrate-maintenance-cli.ts",
    "db:inspect-auth": "tsx server/inspect-auth.ts",
    "test": "tsx --test --test-timeout=30000 server/tests/*.test.ts src/modules/maintenance/services/*.test.ts src/services/*.test.ts",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.build.json",
    "start": "node dist-server/server/index.js",
    "smoke:production": "node --import tsx scripts/smoke-production.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@headless-tree/core": "^1.4.0",
    "@headless-tree/react": "^1.4.0",
    "@hookform/resolvers": "^5.2.1",
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^18.0.9",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "framer-motion": "^12.4.10",
    "helmet": "^8.3.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.542.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-day-picker": "^9.9.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.62.0",
    "react-resizable-panels": "^3.0.5",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.175.0",
    "uuid": "^11.1.0",
    "vaul": "^1.1.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "pg-mem": "^3.0.14",
    "prettier": "3.5.3",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.3.7",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
